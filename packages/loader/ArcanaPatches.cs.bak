    [HarmonyPatch(typeof(global::ArcanaConfig), nameof(global::ArcanaConfig.Name), MethodType.Getter)]
    public static class Patch_ArcanaConfig_get_Name
    {
        public static bool Prefix(global::ArcanaConfig __instance, ref string __result)
        {
            try
            {
                var def = ArcanaBridge.FindDef(__instance);
                if (def != null)
                {
                    __result = def.Name;
                    return false;
                }
            }
            catch {}
            return true;
        }
    }

    [HarmonyPatch(typeof(global::ArcanaConfig), "GetDescription")]
    public static class Patch_ArcanaConfig_GetDescription
    {
        public static System.Reflection.MethodBase TargetMethod()
        {
            var t = typeof(global::ArcanaConfig);
            return AccessTools.Method(t, "GetDescription") ?? AccessTools.Method(t, "GetEffectDescription");
        }

        public static bool Prefix(global::ArcanaConfig __instance, ref string __result)
        {
            try
            {
                var def = ArcanaBridge.FindDef(__instance);
                if (def != null)
                {
                    __result = def.Text;
                    return false;
                }
            }
            catch {}
            return true;
        }
    }

    [HarmonyPatch]
    public static class Patch_ArcanaChoiceView_SetReward
    {
        public static System.Reflection.MethodBase TargetMethod()
        {
            var t = Type.GetType("Nosebleed.Pancake.View.ArcanaChoiceView, Pancake");
            if (t != null)
            {
                return AccessTools.Method(t, "SetReward");
            }
            return null;
        }

        public static void Postfix(object __instance, global::ArcanaConfig arcanaReward)
        {
            try
            {
                if (__instance == null || arcanaReward == null) return;
                var view = __instance.TryCast<UnityEngine.MonoBehaviour>();
                if (view != null)
                {
                    LoaderLog.Info($"[ArcanaPatches] ArcanaChoiceView.SetReward for {arcanaReward.name} ✓");
                }
            }
            catch (Exception ex)
            {
                LoaderLog.Error($"[ArcanaPatches] Error in ArcanaChoiceView.SetReward postfix: {ex}");
            }
        }
    }

    [HarmonyPatch]
    public static class Patch_CardView_SetArcanaConfig
    {
        public static System.Reflection.MethodBase TargetMethod()
        {
            var t = typeof(CardView);
            if (t != null)
            {
                return AccessTools.Method(t, "SetArcanaConfig") ?? AccessTools.Method(t, "SetCardConfig", new Type[] { typeof(global::ArcanaConfig), typeof(bool) });
            }
            return null;
        }

        public static void Postfix(CardView __instance, global::ArcanaConfig arcanaConfig)
        {
            try
            {
                if (__instance == null || arcanaConfig == null) return;
                var def = ArcanaBridge.FindDef(arcanaConfig);
                if (def == null) return;

                if (!string.IsNullOrEmpty(def.Name) && __instance._cardNameText != null)
                {
                    __instance._cardNameText.text = def.Name;
                }
                if (!string.IsNullOrEmpty(def.Text) && __instance._descriptionText != null)
                {
                    __instance._descriptionText.text = def.Text;
                }
                if (!string.IsNullOrEmpty(def.IconPath))
                {
                    var iconSprite = SpriteLoader.LoadSprite(def.IconPath, def.ModDirectory);
                    if (iconSprite != null && __instance._cardImage != null)
                    {
                        __instance._cardImage.sprite = iconSprite;
                        __instance._cardImage.overrideSprite = iconSprite;
                        __instance._cardImage.enabled = true;
                    }
                }
            }
            catch (Exception ex)
            {
                LoaderLog.Error($"[ArcanaPatches] Error in CardView.SetArcanaConfig postfix: {ex}");
            }
        }
    }
}
