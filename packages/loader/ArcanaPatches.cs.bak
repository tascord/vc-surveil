    [HarmonyPatch]
    public static class Patch_ArcanaRewardPool
    {
        public static System.Reflection.MethodBase TargetMethod()
        {
            var t = typeof(ChooseArcanaModal);
            if (t != null)
            {
                var m = AccessTools.Method(t, "GetArcanaRewardPool");
                if (m != null) return m;
            }
            
            var t2 = Type.GetType("Nosebleed.Pancake.GameLogic.ArcanaManager, Pancake");
            if (t2 != null)
            {
                return AccessTools.Method(t2, "GetPool");
            }
            return null;
        }

        public static void Postfix(Il2CppSystem.Collections.Generic.List<global::ArcanaConfig> arcanaRewardPool, Il2CppSystem.Collections.Generic.List<global::ArcanaConfig> __result)
        {
            try
            {
                var pool = arcanaRewardPool ?? __result;
                if (pool == null) return;

                ArcanaBridge.EnsureCustomArcanasCreated();
                foreach (var arcana in ArcanaBridge.CustomArcanaConfigs)
                {
                    if (arcana != null && !pool.Contains(arcana))
                    {
                        pool.Add(arcana);
                    }
                }
            }
            catch (Exception ex)
            {
                LoaderLog.Error($"[ArcanaPatches] Error injecting arcanas into reward pool: {ex}");
            }
        }
    }

